# Bale Self-Bot Environment Variables Template
# Copy this file to '.env' and fill in your actual credentials.

# Bale Bot / User Token (If Applicable)
BALE_BOT_TOKEN="YOUR_BALE_TOKEN_HERE"

# Google Gemini API Key for AI features
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# Command Prefix (e.g. '.' or '!')
COMMAND_PREFIX="."

# Startup notification target Chat ID (Your Private Chat ID)
STARTUP_NOTIFICATION_CHAT=2091967932

# Whitelisted User IDs allowed to trigger commands (Comma-separated)
WHITELISTED_USERS=2091967932